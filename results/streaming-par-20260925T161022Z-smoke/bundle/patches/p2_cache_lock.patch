+def _patch_slow_open(monkeypatch, delay_s: float) -> tuple[Counter, list]:
+    """Make ``fsspec.open`` (as used by ``video_utils``) sleep before opening.
+
+    Simulates a slow network open. Returns a per-path open counter and the list of
+    opened file handles so tests can check how often each path was opened.
+    """
+    real_open = video_utils.fsspec.open
+    open_counts: Counter = Counter()
+    opened: list = []
+    counts_lock = threading.Lock()
+
+    class _SlowOpenFile:
+        def __init__(self, path):
+            self._path = path
+
+        def __enter__(self):
+            time.sleep(delay_s)
+            handle = real_open(self._path).__enter__()
+            with counts_lock:
+                open_counts[str(self._path)] += 1
+                opened.append(handle)
+            return handle
+
+    monkeypatch.setattr(video_utils.fsspec, "open", _SlowOpenFile)
+    return open_counts, opened
+
+
+def _run_in_threads(fn, args_per_thread: list) -> list:
+    """Run ``fn(*args)`` in one thread per entry, released together by a barrier."""
+    barrier = threading.Barrier(len(args_per_thread))
+    results: list = [None] * len(args_per_thread)
+    errors: list = []
+
+    def _worker(i, args):
+        barrier.wait()
+        try:
+            results[i] = fn(*args)
+        except Exception as e:  # pragma: no cover - surfaced by the assert below
+            errors.append(e)
+
+    threads = [threading.Thread(target=_worker, args=(i, a)) for i, a in enumerate(args_per_thread)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(timeout=30)
+    assert not errors, errors
+    return results
+
+
+class TestVideoDecoderCacheConcurrency:
+    def test_cold_opens_of_different_paths_run_in_parallel(self, tmp_path, monkeypatch):
+        """Slow opens of distinct paths must not serialize on the global cache lock."""
+        delay_s = 0.3
+        paths = _make_distinct_clips(tmp_path, n=2)
+        open_counts, _ = _patch_slow_open(monkeypatch, delay_s)
+        cache = VideoDecoderCache(max_size=10)
+
+        start = time.perf_counter()
+        decoders = _run_in_threads(cache.get_decoder, [(p,) for p in paths])
+        elapsed = time.perf_counter() - start
+
+        # Serialized opens would take >= 2 * delay_s. Parallel opens take ~delay_s.
+        assert elapsed < 1.5 * delay_s, f"cold opens look serialized: {elapsed:.3f}s"
+        assert all(d is not None for d in decoders)
+        assert decoders[0] is not decoders[1]
+        assert cache.size() == 2
+        assert open_counts == Counter({str(p): 1 for p in paths})
+        assert cache._open_locks == {}
+
+    def test_same_path_from_many_threads_is_opened_once(self, tmp_path, monkeypatch):
+        """Concurrent misses on one path must open it once and share one decoder."""
+        paths = _make_distinct_clips(tmp_path, n=1)
+        open_counts, opened = _patch_slow_open(monkeypatch, delay_s=0.2)
+        cache = VideoDecoderCache(max_size=10)
+
+        decoders = _run_in_threads(cache.get_decoder, [(paths[0],)] * 8)
+
+        assert open_counts[str(paths[0])] == 1
+        assert len(opened) == 1
+        assert all(d is decoders[0] for d in decoders)
+        assert cache.size() == 1
+        assert cache._open_locks == {}
+
+    def test_failed_decoder_construction_closes_handle_and_cleans_up(self, tmp_path, monkeypatch):
+        """A file torchcodec cannot decode must close its handle and leave no per-path lock behind."""
+        bad_path = tmp_path / "not_a_video.mp4"
+        bad_path.write_bytes(b"this is not an mp4 container")
+        _, opened = _patch_slow_open(monkeypatch, delay_s=0.0)
+        cache = VideoDecoderCache(max_size=10)
+
+        with pytest.raises(Exception):  # noqa: B017 - torchcodec raises a backend-specific error
+            cache.get_decoder(bad_path)
+
+        assert len(opened) == 1
+        assert opened[0].closed is True
+        assert cache.size() == 0
+        assert cache._open_locks == {}
